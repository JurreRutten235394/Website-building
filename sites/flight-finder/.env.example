# Copy this file to .env and fill in your key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Where the server listens. Use HOST=0.0.0.0 when deploying or running in Docker.
HOST=127.0.0.1
PORT=3000

# Google country and language for prices (nl = Netherlands point of sale, en = English).
SERPAPI_GL=nl
SERPAPI_HL=en
DEFAULT_CURRENCY=EUR

# How long search results are reused. A cached search costs nothing.
CACHE_HOURS=3

# Maximum live searches per day (0 = no limit). Protects the monthly plan.
DAILY_SEARCH_LIMIT=50

# Optional password protection, as user:password. Set this before putting the site online.
BASIC_AUTH=
